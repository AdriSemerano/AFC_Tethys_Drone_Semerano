<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="vfh_training_world">
    <scene>
      <ambient>0.6 0.8 1.0 1.0</ambient>
      <background>0.1 0.3 0.5 1.0</background>
    </scene>

    <physics name="1ms" type="ode">
      <max_step_size>0.007</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 350 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.2 0.5 -1.0</direction>
    </light>
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 150 0 0 0</pose>
      <diffuse>0.6 0.6 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.5 -1.0</direction>
    </light>

    <model name="geofence">
      <static>true</static>
      <!-- Tetto trasparente, muri rimossi -->
      <link name="roof">
        <pose>0 0 300 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>500 500 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>500 500 1</size></box></geometry>
          <material>
            <ambient>0.8 0.9 1.0 1</ambient>
            <diffuse>0.8 0.9 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <transparency>0.8</transparency>
        </visual>
      </link>
    </model>

    <model name="seabed_lowpoly">
      <static>true</static>
      
      <!-- Base profonda 500x500 -->
      <link name="base_deep">
        <pose>0 0 -80 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>500 500 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>500 500 2</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.2 1</ambient>
            <diffuse>0.5 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Argini perimetrali massicci -->
      <link name="bank_n">
        <pose>0 220 -20 0.3 0 0</pose>
        <collision name="col"><geometry><box><size>500 100 120</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>500 100 120</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="bank_s">
        <pose>0 -220 -20 -0.3 0 0</pose>
        <collision name="col"><geometry><box><size>500 100 120</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>500 100 120</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="bank_w">
        <pose>-220 0 -20 0 -0.3 0</pose>
        <collision name="col"><geometry><box><size>100 500 120</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>100 500 120</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="bank_e">
        <pose>220 0 -20 0 0.3 0</pose>
        <collision name="col"><geometry><box><size>100 500 120</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>100 500 120</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>

      <!-- Grandi Dune e Conche Interne -->
      <link name="dune_huge_1">
        <pose>-80 80 -40 0.25 0.3 0.5</pose>
        <collision name="col"><geometry><box><size>120 120 60</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>120 120 60</size></box></geometry><material><ambient>0.7 0.6 0.4 1</ambient><diffuse>0.7 0.6 0.4 1</diffuse></material></visual>
      </link>
      <link name="dune_huge_2">
        <pose>90 -70 -35 -0.2 0.35 1.0</pose>
        <collision name="col"><geometry><box><size>140 90 70</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>140 90 70</size></box></geometry><material><ambient>0.65 0.55 0.35 1</ambient><diffuse>0.65 0.55 0.35 1</diffuse></material></visual>
      </link>
      <link name="dune_steep_3">
        <pose>-40 -100 -45 -0.4 -0.2 -0.2</pose>
        <collision name="col"><geometry><box><size>90 130 55</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>90 130 55</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="dune_steep_4">
        <pose>100 100 -30 0.3 -0.4 0.8</pose>
        <collision name="col"><geometry><box><size>100 100 65</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>100 100 65</size></box></geometry><material><ambient>0.75 0.65 0.45 1</ambient><diffuse>0.75 0.65 0.45 1</diffuse></material></visual>
      </link>
      
      <!-- Ostacoli Naturali Centrali -->
      <link name="spire_center">
        <pose>10 20 -50 0.1 -0.1 0.4</pose>
        <collision name="col"><geometry><box><size>40 40 70</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>40 40 70</size></box></geometry><material><ambient>0.55 0.45 0.25 1</ambient><diffuse>0.55 0.45 0.25 1</diffuse></material></visual>
      </link>
    </model>
  
