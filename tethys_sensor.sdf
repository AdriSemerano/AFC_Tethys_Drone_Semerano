<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="tethys_sensor">
    
    <include>
      <uri>https://fuel.gazebosim.org/1.0/accurrent/models/MBARI Tethys LRAUV</uri>
    </include>

    <link name="sensor_payload">
      <pose>1.5 0 0.2 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>

      <sensor name="camera_frontale" type="camera">
        <topic>/tethys/camera</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>1280</width><height>720</height></image>
          <clip><near>0.2</near><far>50.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="sonar_frontale" type="gpu_lidar">
        <topic>/tethys/sonar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>256</samples>
              <resolution>1</resolution>
              <min_angle>-1.047</min_angle>
              <max_angle>1.047</max_angle>
            </horizontal>
          </scan>
          <range><min>0.3</min><max>40.0</max><resolution>0.05</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="altimetro" type="gpu_lidar">
        <pose>0 0 -0.2 0 1.5707 0</pose>
        <topic>/tethys/altimeter</topic>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
          </scan>
          <range><min>0.5</min><max>100.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <topic>/tethys/imu</topic>
        <update_rate>50</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="sensor_joint" type="fixed">
      <parent>tethys::base_link</parent>
      <child>sensor_payload</child>
    </joint>

  </model>
</sdf>
